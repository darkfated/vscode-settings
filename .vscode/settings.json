{
  // --------------------------------------------------------------
  // 🎨 Интерфейс
  // --------------------------------------------------------------
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "One Dark Pro",
  "editor.fontFamily": "Google Sans Code, Consolas, 'Courier New', monospace",
  "editor.fontSize": 18,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,
  "editor.letterSpacing": 0.3,
  "debug.console.fontSize": 16,
  "workbench.startupEditor": "welcomePage",
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "visible",
  "window.titleBarStyle": "custom",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.wrapTabs": true,
  "workbench.tree.renderIndentGuides": "none",

  // --------------------------------------------------------------
  // 🖱️ Редактор
  // --------------------------------------------------------------
  "editor.accessibilitySupport": "off",
  "editor.multiCursorModifier": "alt",
  "editor.linkedEditing": true,
  "editor.selectionHighlight": true,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.suggest.showStatusBar": true,
  "editor.stickyScroll.enabled": true,
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,
  "editor.wrappingIndent": "same",
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": true,
  "editor.renderFinalNewline": "off",
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line-thin",
  "editor.cursorSmoothCaretAnimation": "on",

  // --------------------------------------------------------------
  // 💾 Файлы, поиск, Git и производительность
  // --------------------------------------------------------------
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.sortOrder": "default",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock, .npmrc, .nvmrc",
    "tsconfig.json": "tsconfig.*.json, tsconfig.app.json, tsconfig.node.json",
    "vite.config.ts": "vite.config.js, vite.config.mts, vitest.config.ts",
    "README.md": "README*.md, CHANGELOG.md, CONTRIBUTING.md, LICENSE",
    ".env": ".env.*, .env.local, .env.*.local",
    "*.tsx": "$(capture).ts, $(capture).css, $(capture).scss",
    "*.jsx": "$(capture).js, $(capture).css, $(capture).scss",
    "Cargo.toml": "Cargo.lock",
    "go.mod": "go.sum",
    "pubspec.yaml": "pubspec.lock",
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/out": true,
    "**/coverage": true,
    "**/.turbo": true,
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.git/objects/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true,
    "**/temp/**": true,
    "**/logs/**": true,
  },
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "diffEditor.ignoreTrimWhitespace": true,
  "git.autofetch": true,
  "git.autofetchPeriod": 900,
  "git.confirmSync": true,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "git.fetchOnPull": true,
  "search.followSymlinks": false,
  "search.smartCase": true,
  "search.useIgnoreFiles": true,

  // --------------------------------------------------------------
  // 🖨️ Форматирование и линтинг
  // --------------------------------------------------------------
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
  },
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.trailingComma": "es5",
  "prettier.arrowParens": "avoid",
  "prettier.experimentalTernaries": true,
  "prettier.printWidth": 120,
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue", "html", "markdown"],

  // --------------------------------------------------------------
  // 🐹 Golang
  // --------------------------------------------------------------
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "go.toolsManagement.autoUpdate": true,
  "go.formatTool": "goimports",
  "gopls": {
    "usePlaceholders": false,
    "staticcheck": true,
    "ui.semanticTokens": true,
    "analyses": {
      "unusedparams": true,
      "shadow": true,
    },
  },
  "go.testExplorer.packageDisplayMode": "flat",

  // --------------------------------------------------------------
  // 🐍 Python
  // --------------------------------------------------------------
  "[python]": {
    "editor.formatOnType": true,
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.indexing": true,
  "python.analysis.enableParallelIndexing": true,
  "python.analysis.packageIndexDepths": [{ "name": "", "depth": 3 }],
  "python.analysis.includeVenvInWorkspaceSymbols": true,

  // --------------------------------------------------------------
  // 🖥️ Терминал, отладка и окружение
  // --------------------------------------------------------------
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.smoothScrolling": true,
  "http.proxySupport": "fallback",
  "security.workspace.trust.enabled": false,
  "extensions.ignoreRecommendations": false,
  "update.mode": "start",

  // --------------------------------------------------------------
  // 💎 Детали расширений
  // --------------------------------------------------------------
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
  "RainbowBrackets.depreciation-notice": false,
  "chatgpt.localeOverride": "ru-RU",
}
